-- ฟังก์ชันสร้างปุ่มสลับการทำงาน (Toggle Feature Buttons)
local function createFeatureButton(name, posY, defaultState)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0, 280, 0, 45)
	btn.Position = UDim2.new(0, 20, 0, posY)
	btn.BackgroundColor3 = defaultState and Color3.fromRGB(46, 139, 87) or Color3.fromRGB(50, 50, 50)
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 15
	btn.Font = Enum.Font.SourceSansBold
	btn.Text = name .. ": " .. (defaultState and "เปิด" or "ปิด")
	btn.Parent = mainFrame
	
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 6)
	corner.Parent = btn
	
	return btn
end

